# Copy to /etc/spinapp-ui/env and fill in real values.
# This file is loaded by systemd (EnvironmentFile=) for the spinapp-ui.service unit.

# Least-privilege kubeconfig (not the cluster-admin /etc/rancher/k3s/k3s.yaml)
# -- generated by install.sh from deploy/k8s-manifests/spinapp-ui-rbac.yaml's
# ServiceAccount token. See INSTALL.md step 12.
KUBECONFIG=/etc/spinapp-ui/kubeconfig.yaml
SPINAPP_UI_NAMESPACE=default

# Flask session signing secret. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SPINAPP_UI_FLASK_SECRET=changeme-generate-a-random-64-char-hex-string

# Keycloak (or any OIDC-compliant provider) realm issuer, e.g.
# https://auth.example.com/realms/myrealm
SPINAPP_UI_OIDC_ISSUER=https://auth.example.com/realms/myrealm

# Client must be a confidential client. If the client_id contains a colon
# (e.g. it's a URL like https://host), Keycloak's HTTP Basic client auth
# breaks because Basic auth splits "user:pass" on the FIRST colon only.
# app.py forces token_endpoint_auth_method=client_secret_post to work around
# this — keep that in place if your client_id also contains a colon.
SPINAPP_UI_OIDC_CLIENT_ID=https://admin.example.com
SPINAPP_UI_OIDC_CLIENT_SECRET=changeme
SPINAPP_UI_OIDC_REDIRECT_URI=https://admin.example.com/oidc/callback

# Local OCI registry (see deploy/k8s-manifests/registry.yaml), reachable via
# hostNetwork on the k3s node itself.
SPINAPP_UI_REGISTRY=localhost:5000

# Public hostname apps are served under (https://<host>/<app-name>/...)
SPINAPP_UI_EXTERNAL_HOST=apps.example.com

# JS build template project (see js-template/ in this repo)
SPINAPP_UI_JS_TEMPLATE=/opt/spinapp-ui/js-template-src/hello-js

# Only needed if any app uses per-app OIDC auth (the "OIDC認証で保護する"
# option in an app's 🔒 認証 tab, alongside Basic Auth). This k3s node's own IP,
# reachable from its Traefik Pods -- lets Traefik's forwardAuth Middleware
# call back into this same process. Usually the node's primary/LAN IP (the
# same one `kubectl get nodes -o wide` shows as INTERNAL-IP). install.sh
# auto-detects and fills this in on a fresh install (reuses the same LAN-IP
# detection the egress NetworkPolicy step already does) -- only relevant to
# fill in by hand here if that detection failed or you're editing this file
# directly instead of using install.sh.
SPINAPP_UI_HOST_IP=

# Only needed if you want to override where /config's "HTTPS" section looks
# for a TLS certificate/key to serve Traefik's "websecure" (443) entryPoint
# directly. The defaults below are almost always fine as-is; just place
# your cert/key at these paths and
# switch to HTTPS from /config. Replacing the files later is picked up
# automatically within ~30s, no restart needed.
SPINAPP_UI_TLS_CERT_PATH=/etc/spinapp-ui/tls/cert.pem
SPINAPP_UI_TLS_KEY_PATH=/etc/spinapp-ui/tls/key.pem

# Peer replication (optional, for availability): shared secret every node
# in the mesh must have set to the SAME value. Peer node URLs themselves
# are registered from /config, not here. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SPINAPP_UI_PEER_TOKEN=

# Only needed if you want "New Site" uploads stored somewhere other than
# /opt/spinapp-ui/sites-data (e.g. a separate data disk) -- install.sh sets
# this automatically when run with SPINDECK_DATA_DIR set, see INSTALL.md.
# SPINAPP_UI_SITES_DATA_DIR=/opt/spinapp-ui/sites-data

# Only needed if Traefik's access log (read directly off disk by the
# Analytics page) lives somewhere other than /var/log/traefik/access.log
# -- install.sh sets this automatically when run with SPINDECK_DATA_DIR
# set, see INSTALL.md. If this doesn't match wherever Traefik is actually
# configured to write (deploy/k8s-manifests/traefik-helmchartconfig.yaml.
# tmpl's --accesslog.filepath), Analytics silently shows no/incomplete
# data instead of erroring -- nothing reads this path but the Analytics
# page itself.
# SPINAPP_UI_TRAEFIK_ACCESS_LOG=/var/log/traefik/access.log

# Only needed to accept IPv6 connections directly at :8080 (not through
# Traefik) -- install.sh sets this to "::" automatically when run with
# SPINDECK_DUAL_STACK set, see INSTALL.md. "::" also accepts IPv4 on Linux
# unless bindv6only is set system-wide.
# SPINAPP_UI_BIND_HOST=0.0.0.0

PORT=8080
